# INTRADAY AI TACHYON — secrets template
# Copy to `.env` and fill in. `.env` is git-ignored and must NEVER be committed.
# Nothing in this file may appear in a log line, an IPC frame, or the UI (CLAUDE.md §5, §8).

# ── Trading mode (CLAUDE.md §9) ────────────────────────────────────────
# PAPER | LIVE.  Defaults to PAPER if unset or unrecognised.
# LIVE additionally requires an interactive confirmation at boot.
TRADING_MODE=PAPER

# ── Angel One SmartAPI ─────────────────────────────────────────────────
SMARTAPI_API_KEY=
SMARTAPI_CLIENT_CODE=
SMARTAPI_PASSWORD=
SMARTAPI_TOTP_SECRET=

# Streaming credential from generateSession — NOT the API key.
# Normally leave this BLANK: SmartApiClient logs in with the four values above and obtains a
# fresh feed token at boot. It remains only as a manual fallback for a machine that cannot
# reach the REST endpoint, and a pasted token expires — the handshake then starts failing
# mid-session with a feed that will not come back.
SMARTAPI_FEED_TOKEN=

# ── Network / Egress ─────────────────────────────────────────────────────
# ANGEL_PUBLIC_IP: the IP address reported in the SmartAPI X-ClientPublicIP header.
# Angel One's WAF whitelists a single address (the Giganode tunnel endpoint,
# 87.76.191.175). Reporting the LAN address here produces HTTP 401/403. Set this
# explicitly when running through a non-Giganode tunnel. Both REST
# (execution.api) and the historical-candles path (angel_adapter) read it.
# ANGEL_SOCKS_PROXY: SOCKS5 endpoint used by the SmartStream WebSocket client
# (websockets>=13 does NOT honour HTTPS_PROXY automatically; the explicit proxy
# wiring prevents the home IP from leaking to the broker). Format:
# socks5h://user:pass@host:port  — the "h" suffix is mandatory: DNS must resolve
# through the proxy. When unset, falls back to HTTPS_PROXY / ALL_PROXY / HTTP_PROXY
# (set by launch_tachyon.bat to socks5://127.0.0.1:8080). Leave blank to disable.
ANGEL_PUBLIC_IP=87.76.191.175
ANGEL_SOCKS_PROXY=socks5h://127.0.0.1:8080

# ── Google Gemini (AI Sentinel) ────────────────────────────────────────
GEMINI_API_KEY=
# Verify the id against GET /v1beta/models before a live session. A wrong id is
# not dangerous — it 404s, the Sentinel degrades to NEUTRAL, and trading continues.
GEMINI_MODEL=gemini-3.5-flash-lite
SENTINEL_ENABLED=true

# ── IPC endpoints (CLAUDE.md §2.1) ─────────────────────────────────────
ZMQ_TICK_ENDPOINT=tcp://127.0.0.1:5555
ZMQ_STATE_ENDPOINT=tcp://127.0.0.1:5556
ZMQ_SENTINEL_ENDPOINT=tcp://127.0.0.1:5557

# ── UI ─────────────────────────────────────────────────────────────────
UI_HOST=127.0.0.1
UI_PORT=8787

# ── Logging ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Telegram operator alerts (utils/telegram_alerts.py) ────────────────
# Outbound only: entry filled, stop-out, 15:15 square-off. Advisory — the bot never reads
# updates, so no Telegram message can reach the trading loop. Leave blank to disable; an
# unconfigured alerter is inert and trading is unaffected.
# Get a token from @BotFather; get the chat id by messaging the bot then reading
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=true
