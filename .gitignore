# Secrets — never commit
.env
*.pem
*.key

# Runtime artefacts — keep the directories in the tree, ignore their contents
logs/*
!logs/.gitkeep
data/ticks/*
!data/ticks/.gitkeep
data/journal/*
!data/journal/.gitkeep
data/instruments/*
!data/instruments/.gitkeep
data/trades/*
!data/trades/.gitkeep
*.lock

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Numba JIT cache
__pycache__/*.nbi
__pycache__/*.nbc

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Claude Code machine-local settings (permissions etc.) — CLAUDE.md is tracked, this is not
.claude/settings.local.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
